generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}



model User {
  id             String          @id @default(uuid())
  name           String
  email          String          @unique
  passwordHash   String
  role           String          @default("STUDENT")
  xp             Int             @default(0)
  coins          Int             @default(0)
  level          Int             @default(1)
  currentStreak  Int             @default(0)
  longestStreak  Int             @default(0)
  bio            String          @default("")
  skills         String          @default("")
  github         String          @default("")
  linkedin       String          @default("")
  departmentId   String?
  department     Department?     @relation("DepartmentUsers", fields: [departmentId], references: [id])
  hodDepartment  Department?     @relation("DepartmentHOD")
  
  stageProgresses  StageProgress[]
  submissions      Submission[]
  badges           UserBadge[]
  stage1Activities Stage1Activity[]
  stage4Activities Stage4Activity[] @relation("Stage4Activities")
  ownedProjects    Project[]       @relation("OwnedProjects")
  teamMemberships  TeamMember[]    @relation("TeamMemberships")
  teamMessages     Message[]       @relation("TeamMessages")
  
  // Relations for classrooms, mail, courses
  enrolledClassrooms    Classroom[]            @relation("EnrolledClassrooms")
  facultyClassrooms     Classroom[]            @relation("FacultyClassrooms")
  classroomInvitations  ClassroomInvitation[]
  sentMails             Mail[]                 @relation("SentMails")
  receivedMails         Mail[]                 @relation("ReceivedMails")
  courseProgresses      LanguageCourseProgress[]
  assignmentSubmissions AssignmentSubmission[]
  studentProfile        StudentProfile?

  // Faculty Dashboard relations
  timetableSlots        TimetableSlot[]        @relation("FacultyTimetable")
  attendanceRecordsAsStudent AttendanceRecord[] @relation("StudentAttendance")
  periodTopicLogs       PeriodTopicLog[]       @relation("FacultyPeriodLogs")
  coursePlans           CoursePlan[]           @relation("FacultyCoursePlans")
  internalMarksGiven    InternalMark[]         @relation("FacultyMarks")
  internalMarksReceived InternalMark[]         @relation("StudentMarks")
  leaveRequests         LeaveRequest[]         @relation("FacultyLeaves")
  substitutionRequests  SubstitutionRequest[]  @relation("SubstituteRequests")
  notifications         Notification[]         @relation("UserNotifications")
  mentorGroups          MentorGroup[]          @relation("MentorGroups")
  menteeOf              MentorGroup[]          @relation("MenteeOf")
  counselingAsFaculty   CounselingSession[]    @relation("FacultyCounseling")
  counselingAsStudent   CounselingSession[]    @relation("StudentCounseling")
  studentLeaves         StudentLeaveRequest[]  @relation("StudentLeaves")
  inchargeReviews       StudentLeaveRequest[]  @relation("InchargeReviews")

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}


model Department {
  id      String @id @default(uuid())
  name    String
  hodId   String? @unique
  hod     User?   @relation("DepartmentHOD", fields: [hodId], references: [id])
  users   User[]  @relation("DepartmentUsers")
  classes Class[] @relation("DepartmentClasses")
}

model Class {
  id              String   @id @default(uuid())
  name            String
  room            String?
  departmentId    String?
  department      Department? @relation("DepartmentClasses", fields: [departmentId], references: [id])
  students        StudentProfile[]
}

model StudentProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Core Profile Attributes
  studentId       String?  @unique
  rollNumber      String?  @unique
  admissionNo     String?  @unique
  emisNo          String?  @unique
  firstName       String?
  lastName        String?
  phone           String?
  gender          String?
  batch           String?
  semester        Int?
  year            Int?
  admissionDate   DateTime?
  admissionType   String?
  feeStatus       String?
  status          String?  @default("ACTIVE")
  
  classId         String?
  class           Class?   @relation(fields: [classId], references: [id])
  
  // Personal Bio Attributes
  alternatePhone  String?
  dateOfBirth     DateTime?
  bloodGroup      String?
  nationality     String?
  religion        String?
  category        String?
  motherTongue    String?
  aadharNo        String?
  residenceType   String?
  
  // Stored as JSON strings
  address         String?  
  parentInfo      String?  
  references      String?  
  previousEdu     String?  
  scholarships    String?  
  documents       String?  

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Stage {
  id                String          @id @default(uuid())
  number            Int             @unique // 1-4
  name              String
  unlockXpThreshold Int             @default(0)
  progresses        StageProgress[]
}

model StageProgress {
  id          String   @id @default(uuid())
  userId      String
  stageId     String
  status      String   @default("LOCKED")
  completedAt DateTime?
  
  user        User     @relation(fields: [userId], references: [id])
  stage       Stage    @relation(fields: [stageId], references: [id])

  @@unique([userId, stageId])
}

model Problem {
  id              String       @id @default(uuid())
  title           String
  description     String
  difficulty      String
  languageSupport String       // e.g., "javascript,python,cpp" or JSON
  testCases       String       // JSON string of test cases
  submissions     Submission[]
}

model Submission {
  id          String   @id @default(cuid())
  userId      String
  problemId   String
  code        String
  language    String
  status      String
  xpAwarded   Int      @default(0)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem     Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
}

model Stage1Activity {
  id          String   @id @default(cuid())
  userId      String
  type        String   // "READING", "LISTENING", "WRITING", "SPEAKING"
  score       Int      @default(0)
  xpAwarded   Int      @default(0)
  feedback    String?  // Can store JSON string for structured feedback
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentId   String?
  content     Stage1Content? @relation(fields: [contentId], references: [id], onDelete: SetNull)
}

model Stage1Content {
  id          String   @id @default(cuid())
  type        String   // "READING", "LISTENING", "WRITING", "SPEAKING"
  title       String
  content     String   // The passage, prompt, or audio text
  questions   String?  // JSON string of MCQ questions or blanks
  difficulty  String   @default("medium")
  isActive    Boolean  @default(true)
  
  activities  Stage1Activity[]
}

model ProblemStatement {
  id          String   @id @default(uuid())
  title       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  projects    Project[]
}

model Project {
  id                 String   @id @default(uuid())
  name               String
  description        String
  ownerId            String
  problemStatementId String?
  status             String   @default("ACTIVE")
  visibility         String   @default("PUBLIC")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  owner              User              @relation("OwnedProjects", fields: [ownerId], references: [id], onDelete: Cascade)
  problemStatement   ProblemStatement? @relation(fields: [problemStatementId], references: [id], onDelete: SetNull)
  files              ProjectFile[]
  team               Team?
}

model ProjectFile {
  id        String   @id @default(uuid())
  projectId String
  path      String
  content   String
  language  String   @default("plaintext")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path])
}

model Team {
  id        String   @id @default(uuid())
  name      String
  projectId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  members   TeamMember[]
  messages  Message[]
}

model TeamMember {
  id         String   @id @default(uuid())
  teamId     String
  userId     String
  roleInTeam String   @default("MEMBER")
  joinedAt   DateTime @default(now())

  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user       User     @relation("TeamMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model Message {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  content   String
  createdAt DateTime @default(now())

  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation("TeamMessages", fields: [userId], references: [id], onDelete: Cascade)
}

model Badge {
  id          String      @id @default(uuid())
  name        String
  description String
  iconUrl     String
  users       UserBadge[]
}

model UserBadge {
  id        String   @id @default(uuid())
  userId    String
  badgeId   String
  earnedAt  DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id])
  badge     Badge    @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
}

model DailyChallenge {
  id         String   @id @default(uuid())
  date       DateTime @unique
  difficulty String
  xpReward   Int
  coinReward Int
  type       String   // e.g., "QUIZ", "CODING", "LISTENING"
}

model DailyChallengeSet {
  id           String    @id @default(cuid())
  userId       String
  date         String    // "2026-07-20" date string for easy lookup
  stage        Int       @default(1)
  easyDone     Boolean   @default(false)
  mediumDone   Boolean   @default(false)
  hardDone     Boolean   @default(false)
  easyScore    Int       @default(0)   // accuracy/score for easy challenge
  mediumScore  Int       @default(0)
  hardScore    Int       @default(0)
  easyTime     Int       @default(0)   // seconds taken
  mediumTime   Int       @default(0)
  hardTime     Int       @default(0)
  xpAwarded    Int       @default(0)  // 0 until all 3 complete
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@unique([userId, date])
}

// ==========================================
// Phase E: Stage 4 Career Prep Models
// ==========================================

model AptitudeTest {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String   // e.g. "QUANTITATIVE", "LOGICAL", "VERBAL"
  questions   String   // JSON string of questions and options
  timeLimit   Int      // in minutes
  isActive    Boolean  @default(true)
  
  activities  Stage4Activity[]
}

model Stage4Activity {
  id          String   @id @default(cuid())
  userId      String
  type        String   // "APTITUDE", "MOCK_INTERVIEW", "RESUME_SCORE"
  score       Int      @default(0)
  xpAwarded   Int      @default(0)
  feedback    String?  // JSON string for interview evaluation or resume feedback
  createdAt   DateTime @default(now())

  user        User     @relation("Stage4Activities", fields: [userId], references: [id], onDelete: Cascade)
  
  // Optional relation if it's an aptitude test
  testId      String?
  test        AptitudeTest? @relation(fields: [testId], references: [id], onDelete: SetNull)
}

// ==========================================
// Classroom & Mail System Models
// ==========================================

model Mail {
  id          String   @id @default(uuid())
  senderId    String
  sender      User     @relation("SentMails", fields: [senderId], references: [id])
  recipientId String
  recipient   User     @relation("ReceivedMails", fields: [recipientId], references: [id])
  subject     String
  body        String
  isRead      Boolean  @default(false)
  isStarred   Boolean  @default(false)
  isTrash     Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Classroom {
  id           String                @id @default(uuid())
  name         String
  code         String                @unique // 6-char code
  facultyId    String
  faculty      User                  @relation("FacultyClassrooms", fields: [facultyId], references: [id])
  students     User[]                @relation("EnrolledClassrooms")
  invitations  ClassroomInvitation[]
  announcements Announcement[]
  assignments  Assignment[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

model ClassroomInvitation {
  id           String    @id @default(uuid())
  classroomId  String
  classroom    Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  studentId    String
  student      User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status       String    @default("PENDING") // "PENDING", "ACCEPTED", "REJECTED"
  createdAt    DateTime  @default(now())

  @@unique([classroomId, studentId])
}

model Announcement {
  id           String    @id @default(uuid())
  classroomId  String
  classroom    Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  content      String
  createdAt    DateTime  @default(now())
}

model Assignment {
  id           String    @id @default(uuid())
  classroomId  String
  classroom    Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  title        String
  description  String
  dueDate      DateTime
  topic        String    @default("")
  maxPoints    Int       @default(100)
  xpReward     Int       @default(75)
  coinReward   Int       @default(50)
  createdAt    DateTime  @default(now())
  submissions  AssignmentSubmission[]
}

model AssignmentSubmission {
  id           String     @id @default(uuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  code         String
  grade        Int?
  feedback     String?
  status       String     @default("SUBMITTED") // "SUBMITTED", "GRADED"
  createdAt    DateTime   @default(now())

  @@unique([assignmentId, studentId])
}

model LanguageCourseProgress {
  id                 String   @id @default(uuid())
  userId             String
  language           String   // "C", "CPP", "PYTHON"
  completedExercises Int      @default(0)
  totalCredits       Int      @default(0)
  currentStreak      Int      @default(0)
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, language])
}

model FileVersion {
  id        String   @id @default(uuid())
  fileId    String
  content   String
  updatedBy String
  createdAt DateTime @default(now())
}

// ==========================================
// INIXA AI — Model Configuration & Logging
// ==========================================

model AIModelConfig {
  id            String   @id @default(cuid())
  stage         String   // "stage-1", "stage-2", "stage-3", "stage-4", "general"
  role          String   // "STUDENT", "FACULTY", "HOD", "ALL"
  feature       String   // "chat", "code-review", "writing-grade", "mock-interview", "resume-scorer", "idea-gen"
  primaryModel  String   // e.g. "gemini-2.5-flash"
  fallback1     String?
  fallback2     String?
  fallback3     String?
  fallback4     String?
  fallback5     String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([stage, role, feature])
}

model AIRequestLog {
  id            String   @id @default(cuid())
  userId        String
  stage         String
  feature       String
  modelUsed     String
  promptTokens  Int      @default(0)
  responseTime  Int      @default(0)
  success       Boolean  @default(true)
  errorMessage  String?
  proxyUsed     String?
  createdAt     DateTime @default(now())
}

model AIAdminSettings {
  id                String   @id @default(cuid())
  g4fBaseUrl        String   @default("https://g4f.dev")
  autoUpdateEnabled Boolean  @default(true)
  lastG4fUpdate     DateTime?
  proxyEnabled      Boolean  @default(true)
  customProxies     String?  // JSON array of custom proxy URLs
  updatedAt         DateTime @updatedAt
}

// ==========================================
// Faculty Dashboard Models
// ==========================================

/// Weekly timetable slot for a faculty member
model TimetableSlot {
  id          String   @id @default(uuid())
  facultyId   String
  faculty     User     @relation("FacultyTimetable", fields: [facultyId], references: [id], onDelete: Cascade)
  dayOfWeek   Int      // 1=Mon .. 5=Fri
  periodNo    Int      // 1..8
  subject     String
  classGroup  String   // e.g. "CSE-A", "IT-B"
  room        String   @default("")
  startTime   String   // "09:00"
  endTime     String   // "09:50"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  attendanceRecords AttendanceRecord[]
  periodTopicLogs   PeriodTopicLog[]
  substitutions     SubstitutionRequest[]
}

/// Daily attendance record per student per timetable slot
model AttendanceRecord {
  id             String        @id @default(uuid())
  slotId         String
  slot           TimetableSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  studentId      String
  student        User          @relation("StudentAttendance", fields: [studentId], references: [id], onDelete: Cascade)
  date           String        // "2026-07-27"
  isPresent      Boolean       @default(true)
  markedAt       DateTime      @default(now())

  @@unique([slotId, studentId, date])
}

/// Faculty logs topic taught after each session
model PeriodTopicLog {
  id          String        @id @default(uuid())
  slotId      String
  slot        TimetableSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  facultyId   String
  faculty     User          @relation("FacultyPeriodLogs", fields: [facultyId], references: [id], onDelete: Cascade)
  date        String        // "2026-07-27"
  topicCovered String
  notes       String?
  createdAt   DateTime      @default(now())
}

/// PDF course plan uploaded by faculty per subject
model CoursePlan {
  id          String   @id @default(uuid())
  facultyId   String
  faculty     User     @relation("FacultyCoursePlans", fields: [facultyId], references: [id], onDelete: Cascade)
  subject     String
  classGroup  String
  semester    Int
  academicYear String
  fileName    String
  fileUrl     String   // path relative to /public
  uploadedAt  DateTime @default(now())
}

/// Student internal assessment marks per subject per exam type
model InternalMark {
  id          String   @id @default(uuid())
  facultyId   String
  faculty     User     @relation("FacultyMarks", fields: [facultyId], references: [id], onDelete: Cascade)
  studentId   String
  student     User     @relation("StudentMarks", fields: [studentId], references: [id], onDelete: Cascade)
  subject     String
  classGroup  String
  examType    String   // "CIA1", "CIA2", "MODEL", "PRACTICAL"
  maxMark     Int      @default(100)
  scoredMark  Int      @default(0)
  remarks     String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([facultyId, studentId, subject, examType])
}

/// Faculty leave request
model LeaveRequest {
  id            String   @id @default(uuid())
  facultyId     String
  faculty       User     @relation("FacultyLeaves", fields: [facultyId], references: [id], onDelete: Cascade)
  leaveType     String   // "CL", "ML", "OD", "COMP_OFF"
  fromDate      DateTime
  toDate        DateTime
  reason        String
  status        String   @default("PENDING") // "PENDING", "SUB_PENDING", "APPROVED", "REJECTED"
  hodRemark     String?
  appliedAt     DateTime @default(now())
  reviewedAt    DateTime?

  substitutions SubstitutionRequest[]
}

/// Per-period substitution request linked to a leave
model SubstitutionRequest {
  id            String        @id @default(uuid())
  leaveId       String
  leave         LeaveRequest  @relation(fields: [leaveId], references: [id], onDelete: Cascade)
  slotId        String
  slot          TimetableSlot @relation(fields: [slotId], references: [id])
  date          String        // "2026-07-27"
  substituteId  String
  substitute    User          @relation("SubstituteRequests", fields: [substituteId], references: [id])
  status        String        @default("PENDING") // "PENDING", "ACCEPTED", "REJECTED"
  respondedAt   DateTime?
  createdAt     DateTime      @default(now())
}

/// In-app notification
model Notification {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  type       String   // "SUBSTITUTION_REQUEST", "LEAVE_STATUS", "HOD_ACTION", "STUDENT_LEAVE"
  title      String
  message    String
  isRead     Boolean  @default(false)
  refId      String?  // id of related LeaveRequest / SubstitutionRequest
  createdAt  DateTime @default(now())
}

/// Mentor-mentee group (faculty mentors a group of students)
model MentorGroup {
  id         String   @id @default(uuid())
  mentorId   String
  mentor     User     @relation("MentorGroups", fields: [mentorId], references: [id], onDelete: Cascade)
  studentId  String
  student    User     @relation("MenteeOf", fields: [studentId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([mentorId, studentId])
}

/// Counseling session log
model CounselingSession {
  id          String   @id @default(uuid())
  facultyId   String
  faculty     User     @relation("FacultyCounseling", fields: [facultyId], references: [id], onDelete: Cascade)
  studentId   String
  student     User     @relation("StudentCounseling", fields: [studentId], references: [id], onDelete: Cascade)
  summary     String
  sessionType String   @default("GENERAL") // "GENERAL", "ACADEMIC", "PERSONAL", "CAREER"
  nextAction  String?
  createdAt   DateTime @default(now())
}

/// Student leave request reviewed by class incharge faculty
model StudentLeaveRequest {
  id              String   @id @default(uuid())
  studentId       String
  student         User     @relation("StudentLeaves", fields: [studentId], references: [id], onDelete: Cascade)
  classInchargeId String?
  classIncharge   User?    @relation("InchargeReviews", fields: [classInchargeId], references: [id])
  fromDate        DateTime
  toDate          DateTime
  reason          String
  leaveType       String   @default("PERSONAL") // "MEDICAL", "PERSONAL", "EVENT", "EXAM"
  status          String   @default("PENDING")  // "PENDING", "APPROVED", "REJECTED", "FORWARDED_TO_HOD"
  inchargeRemark  String?
  appliedAt       DateTime @default(now())
  reviewedAt      DateTime?
}


